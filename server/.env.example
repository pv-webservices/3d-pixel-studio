# Copy to server/.env for local development. Never commit real values.
# On Render, set these as environment variables on the web service instead.

# Local: development. Render: production (enables Secure cookies, HSTS, stricter checks).
NODE_ENV=development
PORT=8787

# Where the SQLite database, uploads, originals and backups live.
# Render: the persistent disk mount path, e.g. /var/data
DATA_DIR=./data

# Public URL of this API (used for uploaded image URLs). Required in production.
API_PUBLIC_URL=http://localhost:8787

# Public website origin (legacy /media/ images are served from it; admin previews load them). Required in production.
SITE_URL=http://localhost:5173

# Comma-separated website origins allowed to read /api/public/* cross-origin. Not needed when the
# website proxies /api to this service (same origin).
CORS_ORIGINS=http://localhost:5173

# Browser cache lifetime for public content, in seconds (published changes appear within this time).
PUBLIC_CACHE_SECONDS=60

# Number of reverse proxies in front of the app (Render: 1) so rate limits see the real client IP.
TRUST_PROXY=0

# Optional tuning
# SESSION_IDLE_HOURS=12
# SESSION_MAX_DAYS=7
# UPLOAD_MAX_MB=20
# UPLOAD_MAX_PER_HOUR=200
# LOGIN_MAX_ATTEMPTS=8
# BACKUP_KEEP=14
